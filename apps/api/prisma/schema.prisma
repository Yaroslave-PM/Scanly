generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  moderator
  admin
}

enum UserStatus {
  active
  shadow_banned
  banned
  deleted
}

enum AuthProvider {
  email
  apple
  vk
  yandex
}

enum Unit {
  g
  kg
  ml
  l
  pcs
}

enum ProductStatus {
  active
  draft
  hidden
}

enum ProductSource {
  open_food_facts
  manual
  user_submitted
  seed
}

enum BarcodeFormat {
  EAN13
  EAN8
  UPCA
  UPCE
}

enum StoreType {
  offline
  online
  delivery
}

enum Availability {
  in_stock
  low
  out_of_stock
  unknown
}

enum PriceSource {
  partner_feed
  import
  user_report
  review
}

enum ReviewStatus {
  pending
  published
  rejected
  hidden
}

enum ReportReason {
  spam
  offensive
  fake
  irrelevant
  other
}

enum ReportStatus {
  open
  resolved
  dismissed
}

enum SummaryStatus {
  ready
  insufficient_data
  failed
}

enum RecommendationKind {
  popular
  nearby
  discount
  similar
  personal
}

enum AlertScope {
  any
  nearby
  specific
}

enum Platform {
  ios
  android
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  email       String?    @unique
  displayName String     @map("display_name")
  avatarUrl   String?    @map("avatar_url")
  role        UserRole   @default(user)
  status      UserStatus @default(active)
  trustScore  Int        @default(0) @map("trust_score")
  homeLat     Float?     @map("home_lat")
  homeLng     Float?     @map("home_lng")
  preferences Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  identities      AuthIdentity[]
  sessions        Session[]
  reviews         Review[]
  votes           ReviewVote[]
  reports         ReviewReport[]
  favorites       Favorite[]
  alerts          PriceAlert[]
  recommendations Recommendation[]
  devices         Device[]

  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("auth_identities")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  deviceId         String?   @map("device_id")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Brand {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  products Product[]

  @@map("brands")
}

model Category {
  id       String     @id @default(uuid()) @db.Uuid
  name     String
  slug     String     @unique
  parentId String?    @map("parent_id") @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  brandId     String?       @map("brand_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  imageUrl    String?       @map("image_url")
  netQuantity Decimal?      @map("net_quantity") @db.Decimal(10, 2)
  unit        Unit?
  ingredients String?
  allergens   String[]
  status      ProductStatus @default(active)
  source      ProductSource @default(manual)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  brand           Brand?           @relation(fields: [brandId], references: [id])
  category        Category?        @relation(fields: [categoryId], references: [id])
  barcodes        Barcode[]
  nutrition       Nutrition?
  rating          Rating?
  summary         ReviewSummary?
  prices          Price[]
  reviews         Review[]
  favorites       Favorite[]
  alerts          PriceAlert[]
  recommendations Recommendation[]

  @@index([name])
  @@map("products")
}

model Barcode {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique
  format    BarcodeFormat
  productId String        @map("product_id") @db.Uuid
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("barcodes")
}

model Nutrition {
  productId  String   @id @map("product_id") @db.Uuid
  kcal       Decimal? @db.Decimal(7, 2)
  protein    Decimal? @db.Decimal(7, 2)
  fat        Decimal? @db.Decimal(7, 2)
  carbs      Decimal? @db.Decimal(7, 2)
  sugar      Decimal? @db.Decimal(7, 2)
  fiber      Decimal? @db.Decimal(7, 2)
  salt       Decimal? @db.Decimal(7, 2)
  perServing Json?    @map("per_serving")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("nutrition")
}

model StoreChain {
  id               String  @id @default(uuid()) @db.Uuid
  name             String  @unique
  logoUrl          String? @map("logo_url")
  website          String?
  affiliateProgram Json?   @map("affiliate_program")
  stores           Store[]

  @@map("store_chains")
}

model Store {
  id           String      @id @default(uuid()) @db.Uuid
  chainId      String?     @map("chain_id") @db.Uuid
  type         StoreType   @default(offline)
  name         String
  address      String?
  city         String?
  lat          Float?
  lng          Float?
  openingHours Json?       @map("opening_hours")
  externalId   String?     @unique @map("external_id")
  chain        StoreChain? @relation(fields: [chainId], references: [id])
  prices       Price[]
  reviews      Review[]
  alerts       PriceAlert[]

  @@index([city])
  @@index([lat, lng])
  @@map("stores")
}

model Price {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  storeId       String       @map("store_id") @db.Uuid
  amount        Decimal      @db.Decimal(12, 2)
  currency      String       @default("RUB") @db.Char(3)
  regularAmount Decimal?     @map("regular_amount") @db.Decimal(12, 2)
  availability  Availability @default(unknown)
  source        PriceSource
  confidence    Int          @default(50)
  observedAt    DateTime     @map("observed_at")
  affiliateUrl  String?      @map("affiliate_url")
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  history       PriceHistory[]

  @@unique([productId, storeId])
  @@map("prices")
}

model PriceHistory {
  id         String   @id @default(uuid()) @db.Uuid
  priceId    String   @map("price_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  observedAt DateTime @map("observed_at")
  price      Price    @relation(fields: [priceId], references: [id], onDelete: Cascade)

  @@index([priceId, observedAt])
  @@map("price_history")
}

model Review {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  rating          Int
  text            String?
  purchasePrice   Decimal?     @map("purchase_price") @db.Decimal(12, 2)
  currency        String?      @db.Char(3)
  storeId         String?      @map("store_id") @db.Uuid
  status          ReviewStatus @default(pending)
  moderationFlags Json         @default("{}") @map("moderation_flags")
  helpfulCount    Int          @default(0) @map("helpful_count")
  reportCount     Int          @default(0) @map("report_count")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store?         @relation(fields: [storeId], references: [id])
  photos  ReviewPhoto[]
  votes   ReviewVote[]
  reports ReviewReport[]

  @@unique([userId, productId])
  @@index([productId, status, helpfulCount])
  @@map("reviews")
}

model ReviewPhoto {
  id       String       @id @default(uuid()) @db.Uuid
  reviewId String       @map("review_id") @db.Uuid
  url      String
  status   ReviewStatus @default(pending)
  review   Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_photos")
}

model ReviewVote {
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@map("review_votes")
}

model ReviewReport {
  id        String       @id @default(uuid()) @db.Uuid
  reviewId  String       @map("review_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  reason    ReportReason
  comment   String?
  status    ReportStatus @default(open)
  createdAt DateTime     @default(now()) @map("created_at")
  review    Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_reports")
}

model Rating {
  productId     String  @id @map("product_id") @db.Uuid
  average       Decimal @default(0) @db.Decimal(3, 2)
  count         Int     @default(0)
  distribution  Int[]
  weightedScore Decimal @default(0) @map("weighted_score") @db.Decimal(5, 4)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model ReviewSummary {
  productId        String        @id @map("product_id") @db.Uuid
  summary          String?
  pros             Json          @default("[]")
  cons             Json          @default("[]")
  themes           Json          @default("[]")
  reviewsCountUsed Int           @default(0) @map("reviews_count_used")
  model            String?
  promptVersion    String?       @map("prompt_version")
  status           SummaryStatus @default(insufficient_data)
  generatedAt      DateTime?     @map("generated_at")
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("review_summaries")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favorites")
}

model PriceAlert {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  productId      String     @map("product_id") @db.Uuid
  targetAmount   Decimal?   @map("target_amount") @db.Decimal(12, 2)
  scope          AlertScope @default(any)
  storeId        String?    @map("store_id") @db.Uuid
  isActive       Boolean    @default(true) @map("is_active")
  lastNotifiedAt DateTime?  @map("last_notified_at")
  lastSeenAmount Decimal?   @map("last_seen_amount") @db.Decimal(12, 2)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  store          Store?     @relation(fields: [storeId], references: [id])

  @@index([productId, isActive])
  @@map("price_alerts")
}

model Recommendation {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String?            @map("user_id") @db.Uuid
  productId   String             @map("product_id") @db.Uuid
  kind        RecommendationKind
  score       Decimal            @default(0) @db.Decimal(8, 4)
  reason      String?
  isSponsored Boolean            @default(false) @map("is_sponsored")
  expiresAt   DateTime?          @map("expires_at")
  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("recommendations")
}

model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  pushToken  String   @unique @map("push_token")
  platform   Platform
  appVersion String?  @map("app_version")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model ScanEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  barcode   String
  productId String?  @map("product_id") @db.Uuid
  found     Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("scan_events")
}

model AffiliateClick {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  priceId   String   @map("price_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("affiliate_clicks")
}
