{
  "expo": {
    "name": "Scanly",
    "slug": "scanly",
    "scheme": "scanly",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы считать штрихкод товара. Фото и видео никуда не отправляются.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геолокация нужна, чтобы показать магазины и цены рядом с вами."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "app.scanly.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.scanly.mobile"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
